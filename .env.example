EOSIN_MODAL_APP_NAME=eosin-glm-ocr
EOSIN_MODAL_WEB_LABEL=bank-parser
EOSIN_MODAL_REQUIRES_PROXY_AUTH=true
EOSIN_MODAL_GPU=L40S
EOSIN_MODAL_CPU=8.0
EOSIN_MODAL_MIN_CONTAINERS=0
EOSIN_MODAL_ALLOW_ALWAYS_ON=false
EOSIN_MODAL_MAX_CONTAINERS=3
EOSIN_MODAL_MAX_INPUTS=35
EOSIN_MODAL_TARGET_INPUTS=35
EOSIN_MODAL_SCALEDOWN_WINDOW=120
EOSIN_MODAL_TIMEOUT=1800
EOSIN_MODAL_STARTUP_TIMEOUT=900
EOSIN_MODAL_MEMORY_MIB=32768
EOSIN_MODAL_OCR_PIPELINE_WORKERS=16
EOSIN_MODAL_OCR_PIPELINE_QUEUE_SIZE=512
EOSIN_MODAL_TAILSCALE_ENABLE=true
EOSIN_MODAL_TAILSCALE_HOSTNAME=eosin-modal-worker
EOSIN_MODAL_TAILSCALE_SOCKS5_PORT=1055
EOSIN_MODAL_TAILSCALE_SOCKS5_URL=socks5h://127.0.0.1:1055

EOSIN_MODAL_VLLM_PORT=8000
EOSIN_MODAL_VLLM_MODEL=zai-org/GLM-OCR
EOSIN_MODAL_VLLM_MODEL_REVISION=
EOSIN_MODAL_SERVED_MODEL_NAME=default
EOSIN_MODAL_VLLM_MAX_MODEL_LEN=12288
EOSIN_MODAL_VLLM_GPU_MEMORY_UTILIZATION=0.92
EOSIN_MODAL_VLLM_MAX_NUM_SEQS=196
EOSIN_MODAL_VLLM_MAX_BATCHED_TOKENS=24576
EOSIN_MODAL_VLLM_SPECULATIVE_CONFIG={"method": "mtp", "num_speculative_tokens": 1}
EOSIN_MODAL_VLLM_FAST_BOOT=false
EOSIN_MODAL_VLLM_ENABLE_SLEEP_MODE=false
EOSIN_MODAL_VLLM_ENABLE_GPU_SNAPSHOT=false
EOSIN_MODAL_ALLOW_GPU_SNAPSHOT=false
EOSIN_MODAL_VLLM_SNAPSHOT_WARMUP_ENABLE=false
EOSIN_MODAL_VLLM_COMMIT_CACHE_AFTER_START=true
EOSIN_MODAL_VLLM_SNAPSHOT_WARMUP_REQUESTS=3
EOSIN_MODAL_VLLM_SNAPSHOT_WARMUP_MODE=multimodal
EOSIN_MODAL_VLLM_ATTENTION_BACKEND=
EOSIN_MODAL_VLLM_ENABLE_SERVER_LOAD_TRACKING=true
EOSIN_MODAL_VLLM_ENABLE_PREFIX_CACHING=true
EOSIN_MODAL_VLLM_KV_CACHE_METRICS=true
EOSIN_MODAL_VLLM_ENABLE_MFU_METRICS=true
EOSIN_MODAL_VLLM_ENABLE_LOGGING_ITERATION_DETAILS=false
EOSIN_MODAL_VLLM_ENABLE_LOG_REQUESTS=false
EOSIN_MODAL_HF_XET_HIGH_PERFORMANCE=1
EOSIN_MODAL_TORCHINDUCTOR_COMPILE_THREADS=1
EOSIN_MODAL_TORCH_NCCL_ENABLE_MONITORING=0
EOSIN_MODAL_PARSER_POOL_SIZE=2
EOSIN_MODAL_CACHE_CONCURRENCY=4
EOSIN_MODAL_CACHE_METHOD=evidence
EOSIN_MODAL_BANK_PARSER_OCR_BACKEND_MODE=page_batch
EOSIN_MODAL_METRICS_PUSH_ENABLE=false
EOSIN_MODAL_METRICS_PUSH_URL=http://<tailscale-ip>:8428/api/v1/import/prometheus
EOSIN_MODAL_METRICS_PUSH_TIMEOUT=1.0
EOSIN_MODAL_METRICS_PUSH_AUTH_HEADER=X-Eosin-Key
EOSIN_MODAL_METRICS_PUSH_TRANSPORT=direct
EOSIN_MODAL_METRICS_PUSH_SOCKS5_URL=socks5h://127.0.0.1:1055

EOSIN_PARSER_BASE_URL=https://<workspace>--bank-parser.modal.run
# Optional local caller aliases if you keep personal-account Modal proxy auth separate.
MODAL_PERSONAL_PROXY_AUTH_TOKEN_ID=
MODAL_PERSONAL_PROXY_AUTH_TOKEN_SECRET=

BANK_PARSER_OCR_BACKEND_MODE=page_batch
BANK_PARSER_LAYOUT_MODE=auto
BANK_PARSER_SAVE_DEBUG_IMAGES=false
BANK_PARSER_ENABLE_PAGE_OCR_RETRY=false
BANK_PARSER_PAGE_OCR_RETRY_ALL=false
BANK_PARSER_PAGE_OCR_RETRY_DPI=300
BANK_PARSER_CAPTURE_RAW_OCR_DEBUG=false
BANK_PARSER_POOL_WAIT_TIMEOUT=1800
BANK_PARSER_OCR_MAX_IMAGE_SIDE=3500
BANK_PARSER_OCR_MAX_IMAGE_PIXELS=9000000
BANK_PARSER_OCR_DOCUMENT_MAX_TOKENS_CAP=4096
BANK_PARSER_OCR_DOCUMENT_MAX_IMAGES_PER_REQUEST=4
BANK_PARSER_OCR_BATCH_DRAIN_MAX_BATCH_SIZE=96
BANK_PARSER_OCR_BATCH_DRAIN_MAX_WAIT_SECONDS=0.05
BANK_PARSER_METRICS_ENABLE_VLLM_PROXY=true
BANK_PARSER_VLLM_METRICS_URL=http://127.0.0.1:8000/metrics
BANK_PARSER_VLLM_METRICS_TIMEOUT=1.5
BANK_PARSER_GPU_METRICS_ENABLE=true
BANK_PARSER_GPU_METRICS_INTERVAL=1.0
BANK_PARSER_METRICS_PUSH_ENABLE=false
BANK_PARSER_METRICS_PUSH_URL=http://<tailscale-ip>:8428/api/v1/import/prometheus
BANK_PARSER_METRICS_PUSH_TIMEOUT=1.0
BANK_PARSER_METRICS_PUSH_AUTH_HEADER=X-Eosin-Key
BANK_PARSER_METRICS_PUSH_AUTH_VALUE=
BANK_PARSER_METRICS_PUSH_TRANSPORT=tailscale-socks5
BANK_PARSER_METRICS_PUSH_SOCKS5_URL=socks5h://127.0.0.1:1055
