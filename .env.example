EOSIN_MODAL_APP_NAME=eosin-glm-ocr
EOSIN_MODAL_GPU=A100-80GB
EOSIN_MODAL_MAX_CONTAINERS=1
EOSIN_MODAL_MAX_INPUTS=256
EOSIN_MODAL_TARGET_INPUTS=256
EOSIN_MODAL_SCALEDOWN_WINDOW=180
EOSIN_MODAL_TIMEOUT=1800
EOSIN_MODAL_MEMORY_MIB=40960
EOSIN_MODAL_OCR_PIPELINE_WORKERS=128
EOSIN_MODAL_OCR_PIPELINE_QUEUE_SIZE=2048
EOSIN_MODAL_TAILSCALE_ENABLE=true
EOSIN_MODAL_TAILSCALE_HOSTNAME=eosin-modal-worker
EOSIN_MODAL_TAILSCALE_SOCKS5_PORT=1055
EOSIN_MODAL_TAILSCALE_SOCKS5_URL=socks5h://127.0.0.1:1055

EOSIN_MODAL_VLLM_PORT=8000
EOSIN_MODAL_VLLM_MODEL=zai-org/GLM-OCR
EOSIN_MODAL_SERVED_MODEL_NAME=default
EOSIN_MODAL_VLLM_MAX_MODEL_LEN=22480
EOSIN_MODAL_VLLM_GPU_MEMORY_UTILIZATION=0.90
EOSIN_MODAL_VLLM_MAX_NUM_SEQS=192
EOSIN_MODAL_VLLM_MAX_BATCHED_TOKENS=32768
EOSIN_MODAL_VLLM_SPECULATIVE_CONFIG={"method": "mtp", "num_speculative_tokens": 1}
EOSIN_MODAL_VLLM_ENABLE_PREFIX_CACHING=true
EOSIN_MODAL_VLLM_KV_CACHE_METRICS=true
EOSIN_MODAL_VLLM_ENABLE_MFU_METRICS=true
EOSIN_MODAL_VLLM_ENABLE_LOGGING_ITERATION_DETAILS=false
EOSIN_MODAL_VLLM_ENABLE_LOG_REQUESTS=false

EOSIN_PARSER_BASE_URL=https://<workspace>--bank-parser.modal.run

BANK_PARSER_OCR_BACKEND_MODE=document_http
BANK_PARSER_OCR_BATCH_DRAIN_MAX_BATCH_SIZE=96
BANK_PARSER_OCR_BATCH_DRAIN_MAX_WAIT_SECONDS=1.0
BANK_PARSER_METRICS_ENABLE_VLLM_PROXY=true
BANK_PARSER_VLLM_METRICS_URL=http://127.0.0.1:8000/metrics
BANK_PARSER_VLLM_METRICS_TIMEOUT=1.5
BANK_PARSER_GPU_METRICS_ENABLE=true
BANK_PARSER_GPU_METRICS_INTERVAL=1.0
BANK_PARSER_METRICS_PUSH_ENABLE=true
BANK_PARSER_METRICS_PUSH_URL=http://100.99.119.108:8428/api/v1/import/prometheus
BANK_PARSER_METRICS_PUSH_TIMEOUT=1.0
BANK_PARSER_METRICS_PUSH_AUTH_HEADER=X-Eosin-Key
BANK_PARSER_METRICS_PUSH_AUTH_VALUE=
BANK_PARSER_METRICS_PUSH_TRANSPORT=tailscale-socks5
BANK_PARSER_METRICS_PUSH_SOCKS5_URL=socks5h://127.0.0.1:1055
